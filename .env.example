# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) — server only. Used by ingestion/cron to write job data.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- AI provider for resume features (parsing, fit checks, rating, tailoring) ---
# "anthropic" (default) uses Claude with ANTHROPIC_API_KEY.
# "ollama" uses an Ollama server instead — free when it runs on your own machine.
AI_PROVIDER=anthropic

# --- Anthropic (console.anthropic.com → API Keys) ---
# Used for resume features when AI_PROVIDER=anthropic, and always for listing normalization.
# Without it, ingestion falls back to rule-based normalization.
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Ollama (only read when AI_PROVIDER=ollama) ---
# Local server started by the Ollama app or `ollama serve`.
OLLAMA_HOST=http://localhost:11434
# Pull it first: ollama pull qwen3.5:4b  (runs on an 8 GB laptop)
OLLAMA_MODEL=qwen3.5:4b
# Only for a remote server that needs a key (e.g. Ollama Cloud, which is paid). Leave empty locally.
OLLAMA_API_KEY=
# Optional: context window (tokens), per-request timeout, and model "thinking" (slower).
# OLLAMA_NUM_CTX=16384
# OLLAMA_TIMEOUT_SECONDS=600
# OLLAMA_THINK=false

# --- App ---
# Public base URL, used for auth redirects (e.g. https://interntrack.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron ---
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate-a-long-random-string

# --- Ingestion tuning (optional) ---
# Max listings sent to Claude per refresh run (cost control).
INGEST_AI_MAX_PER_RUN=100
# Only ingest community-list postings posted within this many days.
INGEST_MAX_AGE_DAYS=150

# --- Matching (optional) ---
# Jobs scored per "Refresh my matches" click (unlimited plan only), 10–100.
MATCH_CANDIDATES=30
